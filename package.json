{
  "name": "iskron-skills",
  "private": true,
  "description": "Скиллы агента для iskron и исполняемый код их поставки: мост stdio↔https, сторожа стояния, расширение pi, рендер роадмапа. Рантайм без зависимостей; всё ниже — тулчейн разработки.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"]
  },
  "scripts": {
    "lint": "eslint \"js/**/*.{ts,mjs}\" \"scripts/build-js.mjs\"",
    "format": "prettier --write \"js/**/*.{ts,mjs}\" \"scripts/build-js.mjs\"",
    "format:check": "prettier --check \"js/**/*.{ts,mjs}\" \"scripts/build-js.mjs\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "test": "node --test js/tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage js/tests/*.test.mjs",
    "build": "node scripts/build-js.mjs",
    "check": "node scripts/build-js.mjs --check"
  },
  "lint-staged": {
    "js/**/*.{ts,mjs}": [
      "eslint --fix --max-warnings=9999",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.5.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.58.2"
  }
}
