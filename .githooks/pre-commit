#!/usr/bin/env bash
# На каждом коммите: линт и формат застейдженных исходников js/, dev-сборка
# отгружаемого JS в dist/dev (вне индекса — ею гонятся пробы) и пересборка бандлов
# .skill. Закоммиченные выходы JS — сборка выпуска, их пишет только джоб выпуска
# (make build-release, #6650): хук их не трогает. Включается один раз: make hooks.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

if [[ ! -d js/node_modules ]]; then
  echo "pre-commit: нет js/node_modules — прогони 'make deps' (тулчейн js/ нужен для линта и сборки)" >&2
  exit 1
fi

(cd js && npx --no-install lint-staged)
node js/build.mjs >/dev/null
bash "$root/scripts/build-skills.sh" >/dev/null
git add -- "$root"/*.skill
